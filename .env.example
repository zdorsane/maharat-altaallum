# PostgreSQL (Neon). DATABASE_URL is the pooled connection used by the app;
# DATABASE_URL_UNPOOLED is the direct connection used by migrations.
# On Vercel these are injected by the Neon integration; locally run `vercel env pull .env`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# First super admin, created on deploy by prisma/bootstrap.ts (bcrypt hash, never the plain password).
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
